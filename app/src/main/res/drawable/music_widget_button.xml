<?xml version="1.0" encoding="utf-8"?>
<!-- The player widget's keys (05.11): raised, and pressed in. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#FF34373C" android:startColor="#FF1F2124" />
            <stroke android:width="1dp" android:color="#FF0E0F11" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#FF2E3135" android:startColor="#FF54585E" />
            <stroke android:width="1dp" android:color="#FF0E0F11" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
