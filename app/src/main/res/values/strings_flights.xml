    <string name="ach_first_flight">First flight</string>
    <string name="ach_first_flight_text">Make your first flight</string>
    <string name="ach_first_flight_joke">Congratulations: you have officially left the ground. Mum is proud, ears are popping.</string>
    <string name="ach_flights_100">A hundred flights</string>
    <string name="ach_flights_100_text">Fly 100 times</string>
    <string name="ach_flights_100_joke">A hundred safety briefings. You could give the next one yourself.</string>
    <string name="ach_flights_1000">A thousand flights</string>
    <string name="ach_flights_1000_text">Fly 1000 times</string>
    <string name="ach_flights_1000_joke">A thousand flights. The crew greet you by name, and you greet them by flight number.</string>
    <string name="ach_around_the_earth">Round the Earth</string>
    <string name="ach_around_the_earth_text">Fly 40 075 km</string>
    <string name="ach_around_the_earth_joke">Forty thousand kilometres. Magellan\'s crew needed three years; you needed a pile of boarding passes.</string>
    <string name="ach_to_the_moon">To the Moon</string>
    <string name="ach_to_the_moon_text">Fly 384 400 km</string>
    <string name="ach_to_the_moon_joke">You have flown to the Moon. Flying back is the ×2.</string>
    <string name="ach_day_in_the_air">A day in the air</string>
    <string name="ach_day_in_the_air_text">Spend 24 hours flying</string>
    <string name="ach_day_in_the_air_joke">A whole day with no ground underfoot. Chicken or fish? Fish, as usual.</string>
    <string name="ach_week_in_the_air">A week in the air</string>
    <string name="ach_week_in_the_air_text">Spend a week flying</string>
    <string name="ach_week_in_the_air_joke">A week in the sky. That is not a business trip any more, that is a shift.</string>
    <string name="ach_month_in_the_air">A month in the air</string>
    <string name="ach_month_in_the_air_text">Spend 30 days flying</string>
    <string name="ach_month_in_the_air_joke">A month in the air. Time to register your address as row 23.</string>
    <string name="ach_year_in_the_air">A year in the air</string>
    <string name="ach_year_in_the_air_text">Spend 365 days flying</string>
    <string name="ach_year_in_the_air_joke">A year in the sky. The Earth, it turns out, is just a change of planes.</string>
    <string name="ach_countries_10">Ten countries</string>
    <string name="ach_countries_10_text">Fly to or from 10 countries</string>
    <string name="ach_countries_10_joke">Ten countries. The passport is starting to look serious.</string>
    <string name="ach_countries_50">Fifty countries</string>
    <string name="ach_countries_50_text">Fly to or from 50 countries</string>
    <string name="ach_countries_50_joke">Fifty countries. Border guards leaf through your passport longer than you flew.</string>
    <string name="ach_airlines_10">Ten airlines</string>
    <string name="ach_airlines_10_text">Fly with 10 airlines</string>
    <string name="ach_airlines_10_joke">Ten airlines: ten ways to show you how to fasten the same belt.</string>
    <string name="ach_aircraft_10">Ten aircraft</string>
    <string name="ach_aircraft_10_text">Fly on 10 different aircraft types</string>
    <string name="ach_aircraft_10_joke">Ten different aircraft. You tell an A320 from a 737 by the sound of the toilet door.</string>
    <string name="ach_airports_10">Ten airports</string>
    <string name="ach_airports_10_text">Fly through 10 airports</string>
    <string name="ach_airports_10_joke">Ten airports. You know where the sockets are in each of them.</string>
    <string name="ach_airports_100">A hundred airports</string>
    <string name="ach_airports_100_text">Fly through 100 airports</string>
    <string name="ach_airports_100_joke">A hundred airports. Duty free no longer surprises you with anything.</string>
    <string name="ach_airports_1000">A thousand airports</string>
    <string name="ach_airports_1000_text">Fly through 1000 airports</string>
    <string name="ach_airports_1000_joke">A thousand airports. Are you ever home?</string>
    <string name="ach_time_killer">Time killer</string>
    <string name="ach_time_killer_text">Spend 8 hours or more changing planes</string>
    <string name="ach_time_killer_joke">Eight hours between flights. You have studied every shop, every bench and every crack in the ceiling.</string>
    <string name="ach_time_traveller">Time traveller</string>
    <string name="ach_time_traveller_text">Land before you took off, by the local clocks</string>
    <string name="ach_time_traveller_joke">Landed before you took off. Doc Brown would approve — and no DeLorean needed.</string>
    <string name="ach_flight_attendant">Flight attendant</string>
    <string name="ach_flight_attendant_text">Fly a turnaround: out and straight back</string>
    <string name="ach_flight_attendant_joke">Out and straight back without setting foot in town. Just like the crew.</string>
