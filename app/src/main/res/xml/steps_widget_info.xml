<?xml version="1.0" encoding="utf-8"?>
<!-- Today's steps on the home screen (25.10). Redrawn by the app with the tasks
     widget, and every half hour besides, so that it moves on to the new day. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/steps_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="80dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="60dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
